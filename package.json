{
  "name": "last-lst97-dev-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "dev:rag": "bun run scripts/dev-with-embedding.ts",
    "embedding:serve": "bun run scripts/start-embedding.ts",
    "embedding:test": "bun test tests/server/embedding-process.test.ts tests/server/knowledge-providers.test.ts",
    "worker": "bun run scripts/knowledge-worker.ts",
    "knowledge:sync": "bun run scripts/sync-knowledge.ts",
    "knowledge:migrate": "bun run scripts/migrate-knowledge.ts",
    "knowledge:github:sync": "bun run scripts/sync-github-knowledge.ts",
    "knowledge:github:reindex": "bun run scripts/reindex-github-reports.ts",
    "wakatime:import": "bun run scripts/import-wakatime-history.ts",
    "generate-routes": "tsr generate",
    "build": "bunx payload generate:types && bunx payload generate:importmap && bunx --bun vite build",
    "start": "bun ./dist/server/server.js",
    "payload": "bunx payload",
    "generate:types": "bunx payload generate:types",
    "generate:importmap": "bunx payload generate:importmap",
    "db:up": "docker compose up -d db",
    "db:migrate": "bunx payload migrate",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "knowledge:github:catalog": "bun run scripts/sync-project-catalog.ts"
  },
