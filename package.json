{
  "name": "last-lst97-dev-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run db:migrate:check && bunx --bun vite dev --port 3000",
    "dev:rag": "bun run scripts/dev/dev-with-embedding.ts",
    "embedding:serve": "bun run scripts/dev/start-embedding.ts",
    "embedding:test": "bun test tests/server/embedding-process.test.ts tests/server/knowledge-providers.test.ts",
    "worker": "bun run scripts/dev/knowledge-worker.ts",
    "knowledge:sync": "bun run scripts/knowledge/sync-knowledge.ts",
    "knowledge:migrate": "bun run scripts/knowledge/migrate-knowledge.ts",
    "knowledge:github:sync": "bun run scripts/knowledge/sync-github-knowledge.ts",
    "knowledge:github:reindex": "bun run scripts/knowledge/reindex-github-reports.ts",
    "knowledge:interview:index": "bun run scripts/knowledge/index-interview-knowledge.ts",
    "knowledge:services:index": "bun run scripts/knowledge/index-services-knowledge.ts",
    "knowledge:projects:index": "bun run scripts/knowledge/index-project-docs-knowledge.ts",
    "wakatime:import": "bun run scripts/knowledge/import-wakatime-history.ts",
    "generate-routes": "tsr generate",
    "generate:payload-admin-css": "bun run scripts/assets/generate-payload-admin-css.ts",
    "generate:og-image": "bun run scripts/assets/generate-og-image.ts",
    "build": "bun run generate:payload-admin-css && bun run generate:types && bun run generate:importmap && bun run deploy:migrate && bunx --bun vite build",
    "start": "bun ./dist/server/server.js",
    "payload": "bunx payload",
    "generate:types": "bunx ${PAYLOAD_BUNX_FLAGS:-} payload ${PAYLOAD_CLI_ARGS:-} generate:types",
    "generate:importmap": "bunx ${PAYLOAD_BUNX_FLAGS:-} payload ${PAYLOAD_CLI_ARGS:-} generate:importmap",
    "db:migrate:check": "bun run scripts/database/check-payload-migrations.ts",
    "deploy:migrate": "bun run scripts/database/deploy-migrate.ts",
    "db:migrate": "bunx payload migrate",
    "check:server": "biome check src/server",
    "format:server": "biome format --write src/server",
    "imports:check": "biome check --formatter-enabled=false --linter-enabled=false --assist-enabled=true src/server src/components src/routes",
    "imports:organize": "biome check --formatter-enabled=false --linter-enabled=false --assist-enabled=true --write src/server src/components src/routes",
    "lint:server": "biome lint src/server",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "knowledge:github:catalog": "bun run scripts/knowledge/sync-project-catalog.ts",
    "seed:demo": "bun scripts/seeding/seed-demo-content.ts",
    "seed:projects": "bun run scripts/seeding/seed.ts projects",
    "seed:posts": "bun run scripts/seeding/seed.ts posts",
    "seed:change-logs": "bun run scripts/seeding/seed.ts change-logs",
    "seed:content": "bun run scripts/seeding/seed.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
