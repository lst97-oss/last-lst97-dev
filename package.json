    "@tanstack/router-cli": "^1.167.40",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "bun-types": "^1.4.2",
    "nitro": "^3.0.260903-beta",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "pnpm": {
