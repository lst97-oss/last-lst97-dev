    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.10.1",
