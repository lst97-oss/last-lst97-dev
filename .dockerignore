# Build + runtime context. Keep the image lean and secret-free:
# runtime config comes from the container environment, never baked in.
node_modules
dist
dist-ssr
.git
.gitignore
.vscode
.tanstack
.nitro
.output
.vinxi
.wrangler
__unconfig*

# Secrets — never COPY these into the image.
.env
.env.*
*.local

# Payload generated artefacts (regenerate via bunx payload generate:types /
# generate:importmap) — the build stage regenerates them; the runner stage
# copies the fresh files from the build stage instead of the host.
payload-types.ts
src/payload-import-map.ts

# Dev / docs / test artefacts not needed at runtime.
# NOTE: `vendor/` is intentionally NOT ignored — vite.config.ts and src/
# import from vendor/payload-tanstack-vite/* and vendor/*.ts at build time.
tests
docs
.superpowers
public/assets/.DS_Store
.DS_Store
*.tsbuildinfo
bun.lockb
__pycache__/
*.pyc
*.pyo
todos.json
.cta.json
