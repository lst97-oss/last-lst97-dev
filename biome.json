{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/server/**", "src/components/**", "src/routes/**"]
  },
  "formatter": {
    "enabled": true,
    "includes": ["src/server/**"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "includes": ["src/server/**"],
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": true,
    "includes": ["src/server/**", "src/components/**", "src/routes/**"],
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": false
          }
        }
      }
    }
  }
}
