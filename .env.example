PAYLOAD_SECRET=
# Postgres passwords for the composed `db` / `rag-db` services.
PAYLOAD_DB_PASSWORD=
RAG_DB_PASSWORD=
# Local dev (no Docker): postgres on localhost.
# Under `docker compose`, DATABASE_URL / KNOWLEDGE_DATABASE_URL are
# constructed by compose to reach the `db` / `rag-db` services, so the
# values here are ignored by the `app` service (override on the
# command line if you use an external database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
KNOWLEDGE_DATABASE_URL=postgres://rag:rag-local-dev@127.0.0.1:5435/rag
# Set SKIP_MIGRATIONS=true on scaled `app` replicas; the primary keeps it
# unset so the entrypoint runs `payload migrate` before serving.
SKIP_MIGRATIONS=false
# Optional published-port remaps (host IP:port for loopback-bound services).
APP_PORT=3000
DB_PORT=5432
RAG_DB_PORT=5435
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=LAST//OS
CONTACT_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TYPESAFE_API_KEY=
MODERATION_MIN_CONFIDENCE=0.75
CHAT_CONTEXT_SIGNING_SECRET=
# Optional; configure a private Discord diagnostics webhook to enable chat observability.
CHAT_OBSERVABILITY_DISCORD_WEBHOOK_URL=
RATE_LIMIT_HASH_SECRET=
# Required in production; also configure the matching Cloudflare request header rule.
CLOUDFLARE_ORIGIN_VERIFY_SECRET=
CHAT_TOOL_TIMEOUT_MS=15000
CHAT_STREAM_MAX_MS=90000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APP_TITLE=Personal OS Portfolio
OPENROUTER_SYSTEM_PROMPT=
OPENROUTER_TIMEOUT_MS=20000
PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info
KNOWLEDGE_RAG_ENABLED=false
KNOWLEDGE_EMBEDDING_URL=http://127.0.0.1:8787/v1
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Cloud query embeddings; document indexing stays on KNOWLEDGE_EMBEDDING_URL.
KNOWLEDGE_QUERY_EMBEDDING_URL=https://api.siliconflow.com/v1
KNOWLEDGE_EMBEDDING_HOST=127.0.0.1
KNOWLEDGE_EMBEDDING_PORT=8787
KNOWLEDGE_EMBEDDING_TIMEOUT_MS=15000
UNSLOTH_EMBEDDING_MODEL_PATH=
KNOWLEDGE_EMBEDDING_SERVER_PATH=llama-server
SILICONFLOW_API_KEY=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto
