# Signs and derives Payload's auth key. In the deployment secret store this
# MUST be stored as an encrypted Secret, never as a plaintext "Config" value:
# Config is readable by anyone with project access, and the current value is
# not retrievable once stored, so a mistake here cannot be undone by reading
# it back. Generate with `openssl rand -base64 48 | tr -d '\n' | tr '/+' '_-'`.
#
# Rotating it invalidates active admin sessions (JWTs are signed with the
# derived key) but NOT stored passwords, which hash against a per-user salt.
# This app sets no `useAPIKey` collection and no encrypted fields, so there is
# no data to re-key. You will simply be asked to sign in again.
PAYLOAD_SECRET=
# Remote PostgreSQL (pgvector) connection URLs. Keep credentials only in
# the ignored local `.env` or deployment secret store; URL-encode any
# reserved characters in passwords.
DATABASE_URL=
KNOWLEDGE_DATABASE_URL=
# Zeabur-hosted PostgreSQL uses a self-signed certificate. `sslmode=require`
# alone fails node-postgres ("self signed certificate") because it verifies the
# cert against the system CA store; `no-verify` still forces TLS but skips
# identity verification. Use `verify-full` only if you install the CA.
# Set SKIP_MIGRATIONS=true on scaled container replicas; the primary keeps
# it unset so the entrypoint runs `payload migrate` before serving.
SKIP_MIGRATIONS=false
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=LAST//OS
CONTACT_TO=
# Local development: use Cloudflare's documented dummy keys so chat and contact
# can be exercised end to end without a real challenge (the dummy token is
# XXXX.DUMMY.TOKEN.XXXX). Never deploy these - they always pass verification.
#   site:  1x00000000000000000000AA          secret: 1x0000000000000000000000000000000AA
# The dummy secret's siteverify response omits `action` and reports
# hostname "example.com", so src/server/contact/turnstile-verifier.ts relaxes
# those two checks only while the dummy secret is configured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TYPESAFE_API_KEY=
# Minimum Jev confidence for any safety or contact-intent decision to pass.
# Lower values admit more borderline-but-genuine messages and more borderline
# unsafe ones; see src/server/moderation/AGENTS.md for measured scores.
MODERATION_MIN_CONFIDENCE=0.6
CHAT_CONTEXT_SIGNING_SECRET=
# Optional; configure a private Discord diagnostics webhook to enable chat observability.
CHAT_OBSERVABILITY_DISCORD_WEBHOOK_URL=
RATE_LIMIT_HASH_SECRET=
# Vercel overwrites x-forwarded-for; no application-level ingress secret is needed.
CHAT_TOOL_TIMEOUT_MS=15000
CHAT_STREAM_MAX_MS=90000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APP_TITLE=Personal OS Portfolio
OPENROUTER_SYSTEM_PROMPT=
OPENROUTER_TIMEOUT_MS=20000
# Canonical origin for SEO. Meta tags, canonical links, og:url, sitemap.xml,
# robots.txt and security.txt are all built from this at build time (Vite define).
# In production this MUST be the real public origin — a localhost value makes
# every canonical point at localhost and the site cannot be indexed.
PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info
KNOWLEDGE_RAG_ENABLED=false
# A loopback KNOWLEDGE_EMBEDDING_URL is the local llama-server sidecar and uses
# KNOWLEDGE_EMBEDDING_API_KEY (usually blank). Any other host is a remote
# provider and takes its key from SILICONFLOW_API_KEY instead. Production has no
# local model, so it must set this to the cloud endpoint and leave
# KNOWLEDGE_EMBEDDING_API_KEY unset — the loopback default silently stalls every
# index job there.
KNOWLEDGE_EMBEDDING_URL=http://127.0.0.1:8787/v1
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Cloud query embeddings, independent of where document indexing runs.
KNOWLEDGE_QUERY_EMBEDDING_URL=https://api.siliconflow.com/v1
KNOWLEDGE_EMBEDDING_HOST=127.0.0.1
KNOWLEDGE_EMBEDDING_PORT=8787
KNOWLEDGE_EMBEDDING_TIMEOUT_MS=15000
UNSLOTH_EMBEDDING_MODEL_PATH=
KNOWLEDGE_EMBEDDING_SERVER_PATH=llama-server
SILICONFLOW_API_KEY=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto
